page {
  min-height: 100vh;
  height: auto;
  overflow: auto;
  background: #f5f8f2;
}

.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #18352a;
  background: linear-gradient(145deg, #f8faf5 0%, #eef6ec 58%, #e3f0e4 100%);
}

.page-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 58rpx 40rpx 42rpx;
  box-sizing: border-box;
}

.ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ambient-one {
  top: -150rpx;
  right: -120rpx;
  width: 430rpx;
  height: 430rpx;
  background: rgba(139, 196, 142, 0.22);
}

.ambient-two {
  top: 410rpx;
  left: -260rpx;
  width: 460rpx;
  height: 460rpx;
  background: rgba(238, 210, 139, 0.12);
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-mark {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
  background: #183b2d;
  box-shadow: 0 10rpx 22rpx rgba(24, 59, 45, 0.18);
}

.brand-mark-dot {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c7e98a;
}

.brand-mark-line {
  position: absolute;
  right: 11rpx;
  bottom: 13rpx;
  width: 26rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #88c89a;
  transform: rotate(-38deg);
}

.brand-name {
  color: #18352a;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-tag {
  margin-left: 16rpx;
  color: #769183;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.hero {
  padding: 92rpx 0 42rpx;
}

.hero-kicker {
  display: flex;
  align-items: center;
  color: #5d816c;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.kicker-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #9bcf72;
  box-shadow: 0 0 0 8rpx rgba(155, 207, 114, 0.16);
}

.section-title {
  margin-top: 22rpx;
  color: #17372a;
  font-size: 58rpx;
  line-height: 1.18;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.title-highlight {
  color: #6a9d52;
}

.hero-desc {
  margin-top: 24rpx;
  color: #708578;
  font-size: 26rpx;
  line-height: 1.75;
}

.hero-route {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}

.route-point {
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #a9c59d;
  border-radius: 50%;
  box-sizing: border-box;
}

.route-point.active {
  border-color: #6caa69;
  background: #6caa69;
  box-shadow: 0 0 0 7rpx rgba(108, 170, 105, 0.14);
}

.route-line {
  width: 54rpx;
  height: 2rpx;
  margin: 0 12rpx;
  background: #b8ccb3;
}

.route-line.short {
  width: 34rpx;
}

.route-label {
  margin-left: 16rpx;
  color: #8ca090;
  font-size: 20rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 12rpx 28rpx rgba(53, 103, 66, 0.06);
  box-sizing: border-box;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
  background: #e3f1dc;
  color: #5d985f;
  font-size: 27rpx;
}

.icon-1 { background: #f6edcf; color: #b18b35; }
.icon-2 { background: #e5ebf4; color: #6785aa; }
.icon-3 { background: #f1e4e0; color: #ad7463; }

.quick-label {
  color: #234334;
  font-size: 26rpx;
  font-weight: 700;
}

.quick-hint {
  margin-top: 7rpx;
  color: #8a9c8f;
  font-size: 20rpx;
}

.login-panel {
  margin-top: 30rpx;
  padding: 32rpx 28rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 20rpx 48rpx rgba(40, 91, 52, 0.11);
}

.panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.panel-eyebrow {
  color: #83a28a;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.panel-title {
  margin-top: 12rpx;
  color: #1a382b;
  font-size: 36rpx;
  font-weight: 700;
}

.panel-spark {
  color: #a2c86f;
  font-size: 42rpx;
  line-height: 1;
}

.login-copy {
  margin-top: 16rpx;
  color: #7c9082;
  font-size: 24rpx;
  line-height: 1.6;
}

.field-gap { margin-top: 18rpx; }

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-top: 26rpx;
  border: none;
  border-radius: 20rpx;
  background: linear-gradient(105deg, #315d43 0%, #4e8b5a 100%);
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(48, 101, 65, 0.2);
}

.button-arrow {
  margin-left: 16rpx;
  color: #c9e49b;
  font-size: 38rpx;
  font-weight: 400;
}

.privacy-note {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  color: #9aaa9e;
  font-size: 20rpx;
}

.lock-icon {
  margin-right: 7rpx;
  color: #83a58b;
  font-size: 24rpx;
}

.footer-note {
  padding: 28rpx 0 0;
  color: #9aac9f;
  font-size: 21rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.error-box {
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  background: rgba(225, 80, 61, 0.1);
  color: #ca4433;
  font-size: 24rpx;
}
.brand-logo-image{width:72rpx;height:72rpx;border-radius:20rpx;margin-right:12rpx}
