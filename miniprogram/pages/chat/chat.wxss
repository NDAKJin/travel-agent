.workspace {
  height: 100%;
  display: flex;
  overflow: hidden;
}

.sidebar {
  width: 160rpx;
  padding: 20rpx 14rpx;
  background: linear-gradient(180deg, #eff8f0 0%, #f7fbf7 100%);
  border-right: 1rpx solid rgba(31, 122, 74, 0.1);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  transition: width 0.2s ease, padding 0.2s ease;
}

.sidebar-collapsed {
  width: 112rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.sidebar-collapsed .sidebar-header {
  flex-direction: row;
  justify-content: flex-start;
  gap: 0;
  min-height: 58rpx;
}

.sidebar-collapsed .chat-brand-row {
  display: none;
}

.sidebar-collapsed .sidebar-toggle {
  flex: 0 0 48rpx;
  width: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  margin: 0;
  top: auto;
  right: auto;
}

.sidebar-top {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sidebar-brand-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sidebar-toggle {
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 16rpx;
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-toggle::after {
  border: none;
}

.sidebar-toggle-icon {
  width: 38rpx;
  height: 28rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  position: relative;
  transition: transform 0.2s ease;
}

.sidebar-toggle-icon-collapsed {
  transform: scaleX(-1);
}

.drawer-line {
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #1d7d4d;
}

.drawer-line-short {
  width: 18rpx;
}

.drawer-chevron {
  width: 10rpx;
  height: 10rpx;
  border-top: 4rpx solid #1d7d4d;
  border-right: 4rpx solid #1d7d4d;
  transform: rotate(45deg);
}

.sidebar-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sidebar-history {
  flex: 1;
  min-height: 0;
}

.history-state {
  font-size: 24rpx;
  margin-top: 12rpx;
}

.history-list {
  height: 100%;
  min-height: 0;
}

.scroll-shell {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  border-radius: 24rpx;
}

.history-scroll-shell {
  margin-top: 6rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.78) 0%, rgba(244, 250, 245, 0.94) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(31, 122, 74, 0.08);
}

.message-scroll-shell {
  min-height: 0;
}

.scroll-gutter {
  padding: 10rpx 14rpx 10rpx 0;
  box-sizing: border-box;
}

.message-scroll-gutter {
  padding: 10rpx 16rpx 28rpx 6rpx;
}

.scroll-fade {
  position: absolute;
  left: 0;
  right: 0;
  height: 28rpx;
  pointer-events: none;
  z-index: 2;
}

.scroll-fade-top {
  top: 0;
  background: linear-gradient(180deg, rgba(246, 251, 246, 0.98) 0%, rgba(246, 251, 246, 0) 100%);
}

.scroll-fade-bottom {
  bottom: 0;
  background: linear-gradient(0deg, rgba(246, 251, 246, 0.98) 0%, rgba(246, 251, 246, 0) 100%);
}

.scroll-fade-chat-top {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0) 100%);
}

.scroll-fade-chat-bottom {
  background: linear-gradient(0deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0) 100%);
}

.session-item {
  position: relative;
  padding: 18rpx 16rpx;
  margin-bottom: 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    inset 0 0 0 1rpx rgba(31, 122, 74, 0.08),
    0 10rpx 20rpx rgba(33, 89, 57, 0.04);
}

.session-delete {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 38rpx;
  height: 38rpx;
  color: #9aafa1;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: center;
  border-radius: 999rpx;
  z-index: 1;
}

.session-delete:active {
  color: #d94841;
  background: rgba(217, 72, 65, 0.1);
}

.session-item-active .session-delete {
  color: rgba(255, 255, 255, 0.78);
}

.session-item-active .session-delete:active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
}

.session-item-active {
  background: linear-gradient(135deg, #2eb872 0%, #1b9a59 100%);
  box-shadow: 0 12rpx 24rpx rgba(28, 145, 84, 0.22);
}

.session-title {
  color: #183526;
  font-size: 26rpx;
  font-weight: 700;
}

.session-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.session-item-active .session-title,
.session-item-active .session-meta {
  color: rgba(255, 255, 255, 0.92);
}

.chat-shell {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.84) 0%, rgba(248, 251, 248, 0.95) 100%);
}

.chat-shell-expanded {
  padding-left: 20rpx;
}

.chat-header {
  position: absolute;
  top: 36rpx;
  right: 36rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logout-button {
  width: 54rpx;
  min-width: 54rpx;
  max-width: 54rpx;
  height: 54rpx;
  padding: 0;
  border: none;
  border-radius: 16rpx;
  background: rgba(255, 245, 243, 0.96);
  box-shadow:
    inset 0 0 0 1rpx rgba(217, 72, 65, 0.14),
    0 10rpx 20rpx rgba(120, 55, 45, 0.08);
  color: #c4473b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-logout {
  width: 100%;
  margin-top: auto;
  display: flex;
  justify-content: center;
}

.logout-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.logout-door {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 11rpx;
  height: 22rpx;
  border: 3rpx solid #c4473b;
  border-right: none;
  border-radius: 5rpx 0 0 5rpx;
}

.logout-arrow {
  position: absolute;
  top: 12rpx;
  right: 1rpx;
  width: 16rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #c4473b;
}

.logout-arrow::before,
.logout-arrow::after {
  content: "";
  position: absolute;
  right: 0;
  width: 9rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #c4473b;
}

.logout-arrow::before {
  top: -4rpx;
  transform: rotate(45deg);
}

.logout-arrow::after {
  top: 4rpx;
  transform: rotate(-45deg);
}

.logout-button::after {
  border: none;
}

.logout-button:active {
  background: rgba(255, 232, 228, 0.98);
}

.new-session-button {
  width: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  height: 60rpx;
  padding: 0;
  border-radius: 18rpx;
  background: rgba(240, 248, 241, 0.96);
  box-shadow:
    inset 0 0 0 1rpx rgba(31, 122, 74, 0.1),
    0 10rpx 20rpx rgba(26, 90, 55, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.new-session-button::after {
  border: none;
}

.new-session-icon {
  width: 34rpx;
  height: 30rpx;
  position: relative;
}

.new-session-bubble {
  position: absolute;
  left: 1rpx;
  top: 1rpx;
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid #1d7d4d;
  border-radius: 14rpx;
  background: transparent;
}

.new-session-tail {
  position: absolute;
  left: 7rpx;
  bottom: 1rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid #1d7d4d;
  border-bottom: 3rpx solid #1d7d4d;
  border-bottom-left-radius: 6rpx;
  transform: skewY(18deg) rotate(-8deg);
  background: transparent;
}

.new-session-dot {
  position: absolute;
  top: 10rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #1d7d4d;
}

.new-session-dot-left {
  left: 9rpx;
}

.new-session-dot-center {
  left: 15rpx;
}

.new-session-dot-right {
  left: 21rpx;
}

.chat-panel {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: inset 0 0 0 1rpx rgba(31, 122, 74, 0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.loading-line {
  margin-bottom: 16rpx;
  font-size: 24rpx;
}

.chat-error {
  margin-bottom: 16rpx;
}

.message-list {
  height: 100%;
  box-sizing: border-box;
}

.message-row {
  display: flex;
  margin-bottom: 18rpx;
}

.message-row-user {
  justify-content: flex-end;
}

.message-bubble {
  max-width: 88%;
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 12rpx 22rpx rgba(24, 65, 42, 0.05);
}

.assistant-bubble {
  background: linear-gradient(180deg, #f7fbf7 0%, #f1f8f2 100%);
}

.user-bubble {
  background: linear-gradient(135deg, #2eb872 0%, #1b9a59 100%);
  color: #ffffff;
}

.message-role {
  color: #193726;
  font-size: 24rpx;
  font-weight: 700;
}

.user-bubble .message-role,
.user-bubble .message-meta {
  color: rgba(255, 255, 255, 0.82);
}

.message-text {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-rich-text {
  margin-top: 10rpx;
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
}

.nearby-results {
  margin-top: 18rpx;
}

.nearby-card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.nearby-card {
  display: flex;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: inset 0 0 0 1rpx rgba(31, 122, 74, 0.08);
}

.nearby-card-index {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #2eb872;
}

.nearby-card-body {
  min-width: 0;
  flex: 1;
}

.nearby-card-name {
  color: #183526;
  font-size: 25rpx;
  font-weight: 700;
}

.nearby-card-address,
.nearby-card-distance,
.nearby-card-description {
  margin-top: 5rpx;
  color: #5e7668;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-word;
}

.nearby-card-distance {
  color: #1d7d4d;
}

.nearby-more-button {
  width: 100%;
  height: 60rpx;
  margin-top: 14rpx;
  padding: 0;
  color: #1d7d4d;
  font-size: 23rpx;
  line-height: 60rpx;
  border: 1rpx solid rgba(31, 122, 74, 0.16);
  border-radius: 14rpx;
  background: #f0f8f1;
}

.nearby-more-button::after {
  border: none;
}

.nearby-no-more {
  margin-top: 14rpx;
  color: #8aa092;
  font-size: 21rpx;
  text-align: center;
}

.message-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5e7668;
}

.composer {
  padding: 20rpx;
  border-radius: 28rpx;
  background: rgba(240, 248, 241, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(31, 122, 74, 0.08);
  flex-shrink: 0;
}

.composer-input-wrap {
  position: relative;
}

.composer-button {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 62rpx;
  min-width: 62rpx;
  max-width: 62rpx;
  height: 62rpx;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2eb872 0%, #1b9a59 100%);
  box-shadow: 0 8rpx 16rpx rgba(28, 145, 84, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-button::after {
  border: none;
}

.send-icon {
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1;
  transform: translate(-1rpx, -1rpx) rotate(-24deg);
}

/* 途见聊天页视觉升级 */
page {
  background: #edf4ec;
}

.page-shell {
  padding: 24rpx;
  box-sizing: border-box;
}

.workspace {
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 20rpx 56rpx rgba(37, 86, 50, 0.12);
}

.sidebar {
  width: 184rpx;
  padding: 24rpx 12rpx;
  background: linear-gradient(180deg, #f1f8ef 0%, #eaf4e9 100%);
  border-right-color: rgba(73, 137, 83, 0.1);
}

.sidebar-collapsed {
  width: 80rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.sidebar-top {
  gap: 18rpx;
}

.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 58rpx;
  width: 100%;
  position: relative;
  box-sizing: border-box;
}

.chat-brand-row {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 0 0 auto;
}

.chat-brand-mark {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border-radius: 17rpx;
  background: #183b2d;
  box-shadow: 0 8rpx 18rpx rgba(24, 59, 45, 0.16);
}

.chat-brand-dot {
  position: absolute;
  top: 13rpx;
  left: 13rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #c7e98a;
}

.chat-brand-line {
  position: absolute;
  right: 10rpx;
  bottom: 12rpx;
  width: 25rpx;
  height: 7rpx;
  border-radius: 8rpx;
  background: #88c89a;
  transform: rotate(-38deg);
}

.chat-brand-name {
  margin-left: 0;
  white-space: nowrap;
  color: #244435;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.sidebar:not(.sidebar-collapsed) .chat-brand-name {
  font-size: 28rpx;
}

.sidebar-toggle {
  position: absolute;
  left: 0;
  top: 7rpx;
  flex: 0 0 50rpx;
  margin: 0;
  width: 50rpx;
  min-width: 50rpx;
  max-width: 50rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.82);
}

.sidebar-header {
  height: 58rpx;
  min-height: 58rpx;
  align-items: center;
}

.sidebar-toggle {
  margin-top: 0;
}

.sidebar-collapsed .sidebar-toggle {
  margin-top: 0;
}

.sidebar-collapsed .sidebar-toggle {
  left: 0;
  top: 7rpx;
  right: auto;
}

.chat-brand-name {
  line-height: 44rpx;
}

.sidebar-toggle-icon {
  position: relative;
  width: 30rpx;
  height: 26rpx;
  display: block;
  transition: transform 0.2s ease;
}

.sidebar-toggle-icon-collapsed {
  transform: scaleX(-1);
}

.toggle-panel {
  position: absolute;
  left: 1rpx;
  top: 2rpx;
  width: 11rpx;
  height: 20rpx;
  border: 3rpx solid #6d9774;
  border-radius: 5rpx;
}

.toggle-arrow {
  position: absolute;
  top: 12rpx;
  right: 1rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #6d9774;
}

.toggle-arrow::after {
  content: "";
  position: absolute;
  top: -4rpx;
  right: 0;
  width: 9rpx;
  height: 9rpx;
  border-top: 3rpx solid #6d9774;
  border-right: 3rpx solid #6d9774;
  transform: rotate(45deg);
}

.sidebar-section {
  gap: 10rpx;
}

.sidebar-history::before {
  content: "历史对话";
  display: block;
  padding: 0 10rpx 4rpx;
  color: #86a08b;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.history-scroll-shell {
  background: rgba(255, 255, 255, 0.42);
  box-shadow: inset 0 0 0 1rpx rgba(73, 137, 83, 0.06);
}

.session-item {
  padding: 17rpx 14rpx;
  margin-bottom: 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.66);
  box-shadow: none;
}

.session-item-active {
  background: linear-gradient(135deg, #477d54 0%, #6a9d63 100%);
  box-shadow: 0 10rpx 22rpx rgba(62, 125, 77, 0.2);
}

.session-title {
  font-size: 24rpx;
}

.session-meta {
  color: #94a79a;
  font-size: 20rpx;
}

.chat-shell {
  padding: 28rpx 28rpx 24rpx;
  gap: 16rpx;
  background: linear-gradient(145deg, #f8fbf7 0%, #eef6ec 100%);
}

.chat-header {
  position: relative;
  top: auto;
  right: auto;
  min-height: 64rpx;
  justify-content: space-between;
}

.chat-heading {
  min-width: 0;
  flex: 1;
  margin-right: 20rpx;
}

.chat-heading-title {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #1d3e2e;
  font-size: 32rpx;
  font-weight: 700;
}

.chat-heading-title text {
  color: #8ba091;
  font-size: 22rpx;
  font-weight: 400;
}

.chat-heading-subtitle {
  margin-top: 6rpx;
  color: #9aac9f;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.new-session-button {
  flex: 0 0 64rpx;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(37, 86, 50, 0.08);
}

.chat-panel {
  padding: 22rpx 18rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 12rpx 28rpx rgba(38, 92, 51, 0.06);
}

.message-scroll-gutter {
  padding: 14rpx 12rpx 30rpx 8rpx;
}

.quick-action-panel {
  width: 100%;
  flex-shrink: 0;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(73, 137, 83, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 18rpx rgba(38, 92, 51, 0.04);
}

.quick-action-grid {
  margin-top: 0;
}

.quick-action-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.quick-action-row:first-child {
  margin-top: 0;
}

.quick-action-button {
  width: 48%;
  height: 60rpx;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #315d43;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 60rpx;
  border: 1rpx solid rgba(73, 137, 83, 0.16);
  border-radius: 18rpx;
  background: #f4faf3;
}

.quick-action-button::after {
  border: none;
}

.quick-action-button:active {
  background: #e7f3e7;
}

.message-row {
  margin-bottom: 20rpx;
}

.message-bubble {
  max-width: 84%;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(24, 65, 42, 0.06);
}

.assistant-bubble {
  border-top-left-radius: 8rpx;
  background: #ffffff;
}

.user-bubble {
  border-top-right-radius: 8rpx;
  background: linear-gradient(135deg, #477d54 0%, #6a9d63 100%);
  box-shadow: 0 10rpx 20rpx rgba(62, 125, 77, 0.16);
}

.message-role {
  color: #6c9271;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.message-text {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.65;
}

.message-rich-text {
  margin-top: 8rpx;
  color: #496453;
  font-size: 25rpx;
  line-height: 1.7;
}

.composer {
  padding: 14rpx;
  border-radius: 24rpx;
  background: rgba(226, 239, 225, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(73, 137, 83, 0.08);
}

.composer-textarea {
