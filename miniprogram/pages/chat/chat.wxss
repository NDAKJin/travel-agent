.workspace {
  height: 100%;
  display: flex;
  overflow: hidden;
}

.sidebar {
  width: 160rpx;
  padding: 20rpx 14rpx;
  background: linear-gradient(180deg, #eff8f0 0%, #f7fbf7 100%);
  border-right: 1rpx solid rgba(31, 122, 74, 0.1);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  transition: width 0.2s ease, padding 0.2s ease;
}

.sidebar-collapsed {
  width: 92rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.sidebar-top {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sidebar-brand-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sidebar-toggle {
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 16rpx;
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-toggle::after {
  border: none;
}

.sidebar-toggle-icon {
  width: 38rpx;
  height: 28rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  position: relative;
  transition: transform 0.2s ease;
}

.sidebar-toggle-icon-collapsed {
  transform: scaleX(-1);
}

.drawer-line {
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #1d7d4d;
}

.drawer-line-short {
  width: 18rpx;
}

.drawer-chevron {
  width: 10rpx;
  height: 10rpx;
  border-top: 4rpx solid #1d7d4d;
  border-right: 4rpx solid #1d7d4d;
  transform: rotate(45deg);
}

.sidebar-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sidebar-history {
  flex: 1;
  min-height: 0;
}

.history-state {
  font-size: 24rpx;
  margin-top: 12rpx;
}

.history-list {
  height: 100%;
  min-height: 0;
}

.scroll-shell {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  border-radius: 24rpx;
}

.history-scroll-shell {
  margin-top: 6rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.78) 0%, rgba(244, 250, 245, 0.94) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(31, 122, 74, 0.08);
}

.message-scroll-shell {
  min-height: 0;
}

.scroll-gutter {
  padding: 10rpx 14rpx 10rpx 0;
  box-sizing: border-box;
}

.message-scroll-gutter {
  padding: 10rpx 16rpx 28rpx 6rpx;
}

.scroll-fade {
  position: absolute;
  left: 0;
  right: 0;
  height: 28rpx;
  pointer-events: none;
  z-index: 2;
}

.scroll-fade-top {
  top: 0;
  background: linear-gradient(180deg, rgba(246, 251, 246, 0.98) 0%, rgba(246, 251, 246, 0) 100%);
}

.scroll-fade-bottom {
  bottom: 0;
  background: linear-gradient(0deg, rgba(246, 251, 246, 0.98) 0%, rgba(246, 251, 246, 0) 100%);
}

.scroll-fade-chat-top {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0) 100%);
}

.scroll-fade-chat-bottom {
  background: linear-gradient(0deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0) 100%);
}

.session-item {
  position: relative;
  padding: 18rpx 16rpx;
  margin-bottom: 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    inset 0 0 0 1rpx rgba(31, 122, 74, 0.08),
    0 10rpx 20rpx rgba(33, 89, 57, 0.04);
}

.session-delete {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 38rpx;
  height: 38rpx;
  color: #9aafa1;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 34rpx;
  text-align: center;
  border-radius: 999rpx;
  z-index: 1;
}

.session-delete:active {
  color: #d94841;
  background: rgba(217, 72, 65, 0.1);
}

.session-item-active .session-delete {
  color: rgba(255, 255, 255, 0.78);
}

.session-item-active .session-delete:active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
}

.session-item-active {
  background: linear-gradient(135deg, #2eb872 0%, #1b9a59 100%);
  box-shadow: 0 12rpx 24rpx rgba(28, 145, 84, 0.22);
}

.session-title {
  color: #183526;
  font-size: 26rpx;
  font-weight: 700;
}

.session-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.session-item-active .session-title,
.session-item-active .session-meta {
  color: rgba(255, 255, 255, 0.92);
}

.chat-shell {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.84) 0%, rgba(248, 251, 248, 0.95) 100%);
}

.chat-shell-expanded {
  padding-left: 20rpx;
}

.chat-header {
  position: absolute;
  top: 36rpx;
  right: 36rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logout-button {
  width: 54rpx;
  min-width: 54rpx;
  max-width: 54rpx;
  height: 54rpx;
  padding: 0;
  border: none;
  border-radius: 16rpx;
  background: rgba(255, 245, 243, 0.96);
  box-shadow:
    inset 0 0 0 1rpx rgba(217, 72, 65, 0.14),
    0 10rpx 20rpx rgba(120, 55, 45, 0.08);
  color: #c4473b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-logout {
  width: 100%;
  margin-top: auto;
  display: flex;
  justify-content: center;
}

.logout-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.logout-door {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 11rpx;
  height: 22rpx;
  border: 3rpx solid #c4473b;
  border-right: none;
  border-radius: 5rpx 0 0 5rpx;
}

.logout-arrow {
  position: absolute;
  top: 12rpx;
  right: 1rpx;
  width: 16rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #c4473b;
}

.logout-arrow::before,
.logout-arrow::after {
  content: "";
  position: absolute;
  right: 0;
  width: 9rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #c4473b;
}

.logout-arrow::before {
  top: -4rpx;
  transform: rotate(45deg);
}

.logout-arrow::after {
  top: 4rpx;
  transform: rotate(-45deg);
}

.logout-button::after {
  border: none;
}

.logout-button:active {
  background: rgba(255, 232, 228, 0.98);
}

.new-session-button {
  width: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  height: 60rpx;
  padding: 0;
  border-radius: 18rpx;
  background: rgba(240, 248, 241, 0.96);
  box-shadow:
    inset 0 0 0 1rpx rgba(31, 122, 74, 0.1),
    0 10rpx 20rpx rgba(26, 90, 55, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.new-session-button::after {
  border: none;
}

.new-session-icon {
  width: 34rpx;
  height: 30rpx;
  position: relative;
}

.new-session-bubble {
  position: absolute;
  left: 1rpx;
  top: 1rpx;
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid #1d7d4d;
  border-radius: 14rpx;
  background: transparent;
}

.new-session-tail {
  position: absolute;
  left: 7rpx;
  bottom: 1rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid #1d7d4d;
  border-bottom: 3rpx solid #1d7d4d;
  border-bottom-left-radius: 6rpx;
  transform: skewY(18deg) rotate(-8deg);
  background: transparent;
}

.new-session-dot {
  position: absolute;
  top: 10rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #1d7d4d;
}

.new-session-dot-left {
  left: 9rpx;
}

.new-session-dot-center {
  left: 15rpx;
}

.new-session-dot-right {
  left: 21rpx;
}

.chat-panel {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: inset 0 0 0 1rpx rgba(31, 122, 74, 0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.loading-line {
  margin-bottom: 16rpx;
  font-size: 24rpx;
}

.chat-error {
  margin-bottom: 16rpx;
}

.message-list {
  height: 100%;
  box-sizing: border-box;
}

.message-row {
  display: flex;
  margin-bottom: 18rpx;
}

.message-row-user {
  justify-content: flex-end;
}

.message-bubble {
  max-width: 88%;
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 12rpx 22rpx rgba(24, 65, 42, 0.05);
}

.assistant-bubble {
  background: linear-gradient(180deg, #f7fbf7 0%, #f1f8f2 100%);
}

.user-bubble {
  background: linear-gradient(135deg, #2eb872 0%, #1b9a59 100%);
  color: #ffffff;
}

.message-role {
  color: #193726;
  font-size: 24rpx;
  font-weight: 700;
}

.user-bubble .message-role,
.user-bubble .message-meta {
  color: rgba(255, 255, 255, 0.82);
}

.message-text {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-rich-text {
  margin-top: 10rpx;
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
}

.nearby-results {
  margin-top: 18rpx;
}

.nearby-card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.nearby-card {
  display: flex;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: inset 0 0 0 1rpx rgba(31, 122, 74, 0.08);
}

.nearby-card-index {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #2eb872;
}

.nearby-card-body {
  min-width: 0;
  flex: 1;
}

.nearby-card-name {
  color: #183526;
  font-size: 25rpx;
  font-weight: 700;
}

.nearby-card-address,
.nearby-card-distance,
.nearby-card-description {
  margin-top: 5rpx;
  color: #5e7668;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-word;
}

.nearby-card-distance {
  color: #1d7d4d;
}

.nearby-more-button {
  width: 100%;
  height: 60rpx;
  margin-top: 14rpx;
  padding: 0;
  color: #1d7d4d;
  font-size: 23rpx;
  line-height: 60rpx;
  border: 1rpx solid rgba(31, 122, 74, 0.16);
  border-radius: 14rpx;
  background: #f0f8f1;
}

.nearby-more-button::after {
  border: none;
}

.nearby-no-more {
  margin-top: 14rpx;
  color: #8aa092;
  font-size: 21rpx;
  text-align: center;
}

.message-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5e7668;
}

.composer {
  padding: 20rpx;
  border-radius: 28rpx;
  background: rgba(240, 248, 241, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(31, 122, 74, 0.08);
  flex-shrink: 0;
}

.composer-textarea {
  min-height: 128rpx;
  background: #ffffff;
  padding-right: 92rpx;
  box-sizing: border-box;
}

.composer-input-wrap {
  position: relative;
}

.composer-button {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 62rpx;
  min-width: 62rpx;
  max-width: 62rpx;
  height: 62rpx;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2eb872 0%, #1b9a59 100%);
  box-shadow: 0 8rpx 16rpx rgba(28, 145, 84, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-button::after {
  border: none;
}

.send-icon {
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1;
  transform: translate(-1rpx, -1rpx) rotate(-24deg);
}
