MYSQL_USER=请填写数据库用户名
MYSQL_PASSWORD=请填写数据库密码
MYSQL_ROOT_PASSWORD=请填写数据库根密码

SPRING_AI_DASHSCOPE_API_KEY=请填写阿里云百炼接口密钥
TRAVEL_AGENT_AUTH_JWT_SECRET=请填写随机JWT密钥

MYSQL_DATABASE=travelagent
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_EXTERNAL_PORT=29092
TRAVEL_AGENT_OBSERVABILITY_KAFKA_TOPIC=agent-observation
TRAVEL_AGENT_OBSERVABILITY_CONSUMER_GROUP=travel-agent-observation-writer
TRAVEL_AGENT_ROUTE_CACHE_TTL=PT24H
TRAVEL_AGENT_ROUTE_CACHE_SIMILARITY_THRESHOLD=0.92
TRAVEL_AGENT_EXTERNAL_HTTP_CONNECT_TIMEOUT=PT3S
TRAVEL_AGENT_EXTERNAL_HTTP_READ_TIMEOUT=PT15S
TRAVEL_AGENT_RAG_OUTBOX_DISPATCH_INTERVAL_MS=1000
TRAVEL_AGENT_RAG_INGESTION_STORAGE_DIR=/data/travel-agent-rag

SPRING_AI_DASHSCOPE_CHAT_OPTIONS_MODEL=qwen3.8-max
SPRING_AI_DASHSCOPE_CHAT_OPTIONS_MULTI_MODEL=true

TRAVEL_AGENT_AUTH_WX_APP_ID=请填写微信小程序应用ID
TRAVEL_AGENT_AUTH_WX_SECRET=请填写微信小程序密钥
