# Copy to .env on the server, then replace every placeholder.
MYSQL_DATABASE=travelagent
MYSQL_USER=travelagent
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
NEO4J_PASSWORD=replace-with-a-strong-neo4j-password
SPRING_NEO4J_URI=bolt://second-server-public-ip:7687
TRAVEL_AGENT_AGENT_ELASTICSEARCH_HOST=second-server-public-ip
TRAVEL_AGENT_AGENT_ELASTICSEARCH_PORT=9200

SPRING_AI_DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
SPRING_AI_DASHSCOPE_CHAT_OPTIONS_MODEL=qwen-plus

# Generate with: openssl rand -base64 48
TRAVEL_AGENT_AUTH_JWT_SECRET=replace-with-a-random-48-byte-secret
TRAVEL_AGENT_AUTH_WX_APP_ID=your-wechat-mini-program-app-id
TRAVEL_AGENT_AUTH_WX_SECRET=your-wechat-mini-program-secret
TRAVEL_AGENT_AMAP_WEB_SERVICE_KEY=your-amap-web-service-key

# These values are baked into the admin web bundle during build.
VITE_AMAP_KEY=your-amap-web-js-key
VITE_AMAP_SECURITY_JS_CODE=your-amap-security-js-code
